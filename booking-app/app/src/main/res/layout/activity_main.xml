<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حجوزات العيادة ✎"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اضغط على العنوان لتغييره"
                android:textColor="#DDE8FF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- تنبيه تفعيل ربط واتساب -->
    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_warn"
        android:padding="12dp"
        android:text="⚠ ربط واتساب غير مفعّل — اضغط هنا للسماح للتطبيق بقراءة رسائل واتساب وتحويلها لحجوزات تلقائياً"
        android:textColor="@color/warn_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- اختيار اليوم -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/prevDay"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/dayLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextDay"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/primary"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- الإحصائيات / الفلتر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipAll"
            style="@style/Chip"
            android:background="@drawable/bg_primary_soft"
            android:textColor="@color/primary" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/chipArrived"
            style="@style/Chip"
            android:background="@drawable/bg_arrived"
            android:textColor="@color/arrived_text" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/chipWaiting"
            style="@style/Chip"
            android:background="@drawable/bg_waiting"
            android:textColor="@color/waiting_text" />
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_input"
        android:hint="🔍  بحث بالاسم..."
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColorHint="@color/text_soft"
        android:textSize="15sp" />

    <!-- الجدول -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_row"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="#"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/colName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:text="اسم المريض/ة"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="الوقت"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="الحالة"
                android:textColor="@color/text"
                android:textStyle="bold" />
        </LinearLayout>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="لا توجد حجوزات لهذا اليوم بعد.\nستظهر هنا تلقائياً عند وصول رسالة واتساب، أو اضغط «إضافة»."
            android:textColor="@color/text_soft"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- الأزرار السفلية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnAdd"
            style="@style/BigButton"
            android:background="@drawable/bg_primary"
            android:text="＋ إضافة حجز"
            android:textColor="#FFFFFF" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnShare"
            style="@style/BigButton"
            android:background="@drawable/bg_primary_soft"
            android:text="مشاركة الجدول"
            android:textColor="@color/primary" />
    </LinearLayout>
</LinearLayout>
